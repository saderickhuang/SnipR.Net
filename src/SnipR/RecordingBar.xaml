<Window x:Class="SnipR.RecordingBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipR · 录制控制" Style="{StaticResource WindowBase}" Width="378" Height="68" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="True">
    <Border Background="#17251E" BorderBrush="#64876C" BorderThickness="1" CornerRadius="12" Padding="16,10" MouseLeftButtonDown="DragBar">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Ellipse Width="9" Height="9" Fill="#FF8A83" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="TimerText" Text="准备录制" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="HintText" Text="Esc 取消" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
            <Button x:Name="StopButton" Grid.Column="2" Content="取消" Click="Stop_Click" Background="#B7F5CF" Foreground="#173324" Padding="16,9" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
